LLM_MODEL_ID=bedrock:anthropic.claude-3-5-sonnet-20240620-v1:0
#ANTHROPIC_API_KEY=...
AWS_ACCESS_KEY_ID='...'
AWS_SECRET_ACCESS_KEY='...'

# Ollama (local or cloud). Use LLM_MODEL_ID=ollama:<model> to select it.
# LOCAL: point at a local Ollama daemon (no key needed).
#OLLAMA_BASE_URL=http://localhost:11434
# CLOUD: point at https://ollama.com and set an API key (sent as Bearer).
#OLLAMA_BASE_URL=https://ollama.com
#OLLAMA_API_KEY=oll-...
#OLLAMA_MODEL=llama3.1

# --- Target Superset instance ---
# The real /home/mlfts/superset dev instance runs on port 8088 (validated:
# /health OK). From inside its docker network use http://superset:8088.
SUPERSET_API_URL=http://localhost:8088

# MCP server service-account login. The real /home/mlfts/superset dev instance
# uses admin/admin (set by its docker/docker-init.sh). Put the REAL values in
# your gitignored .env — not here. (Below are the plugin's own-stack defaults.)
SUPERSET_USERNAME=superset_admin
SUPERSET_PASSWORD=superset

# Preferred over username/password: a scoped FAB API key. NOTE: the real
# /home/mlfts/superset instance has FAB_API_KEY_ENABLED OFF by default (an API
# key is rejected), so the username/password path above is used there. To use
# the API-key path, enable FAB_API_KEY_ENABLED=True + FAB_API_KEY_PREFIXES=
# ["sst_"] on the target first.
#SUPERSET_API_KEY=sst-...

# MCP transport. stdio is the default and works against the real instance
# (which does NOT expose the in-tree mcp_service, so SSE/MCP_TOKEN is not
# available there). Use sse only if you run an MCP server separately.
TRANSPORT_TYPE=stdio

# Checkpointer DB. Plugin's own-stack default below. For the real
# /home/mlfts/superset instance, reuse its postgres:
#   postgresql+psycopg2://superset:superset@localhost:5432/superset (host)
#   postgresql+psycopg2://superset:superset@db:5432/superset      (in-network)
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres:postgres@postgres:5432/postgres

# Secret key for the plugin's own-stack superset_config.py. REQUIRED in
# production; in development (SUPERSET_ENV=development) an ephemeral key is
# generated if unset. (When installed into the real instance, that instance's
# own superset_config.py / SUPERSET_SECRET_KEY governs.)
#SUPERSET_SECRET_KEY=change-me-to-a-long-random-string

GRAPH_DB=falkordb

# Comma-separated FAB role names allowed to use the AI Assistant.
# When unset, any authenticated Superset user may use it.
#AI_ASSISTANT_ALLOWED_ROLES=Admin



